# Copy this file to `.env` and fill in your real values.
# Loaded by `node --env-file=.env ...` — no dotenv package required.

# The agent loop needs one model key, and AGENT_MODEL decides which model
# plays. Anthropic: a key and (optionally) a Claude model id. Gemini: a key
# AND AGENT_MODEL=gemini-3.8-flash; the key alone changes nothing. LLM_MODEL
# is the older name for AGENT_MODEL and only applies when AGENT_MODEL is
# unset. The orchestrator prints "bots run on <model>" before spawning.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# AGENT_MODEL=claude-opus-5
# GEMINI_API_KEY=
# AGENT_MODEL=gemini-3.8-flash
# AGENT_STRATEGIST_MODEL=gemini-3.8-flash   # the think tool's model; defaults to claude-opus-5

# Optional. Defaults shown.
# REDIS_HOST=localhost
# REDIS_PORT=6379
# The server folder the bots read zones, sell prices and faction rules from
# (see server/README.md, "What the bots read from this folder").
# MC_SERVER_DIR=./server
