# Copy this file to `.env` and fill in your real values.
# Loaded by `node --env-file=.env ...` — no dotenv package required.

# The agent loop needs one model key. Anthropic is the default
# (AGENT_MODEL defaults to claude-opus-5); set GEMINI_API_KEY and
# AGENT_MODEL=gemini-3.8-flash to run on Gemini instead.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# GEMINI_API_KEY=
# AGENT_MODEL=gemini-3.8-flash

# Optional. Defaults shown.
# REDIS_HOST=localhost
# REDIS_PORT=6379
# The server folder the bots read zones, sell prices and faction rules from
# (see server/README.md, "What the bots read from this folder").
# MC_SERVER_DIR=./server
